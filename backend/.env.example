# Code Crew Backend - Environment Configuration Template
# Copy this file to .env and set your credentials. DO NOT commit .env to source control.

# GroqCloud API Key (Required for live agent kickoff)
GROQ_API_KEY=your_groq_api_key_here

# Groq Supported Model Identifier (Default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Application Environment (development / production)
ENVIRONMENT=development
DEBUG=False

# CORS Origins (JSON list or comma-separated string)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "https://codecrew-lemon-sigma.vercel.app"]

